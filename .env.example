# StallShark Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git

# Etsy API
ETSY_API_KEY=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# LLM API (mimo-v2.5 via OpenCode)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=your_endpoint_here

# Cloudflare R2 — general
R2_ENDPOINT=https://954612afb5a97bb15dddcdc70176813d.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key

# Cloudflare R2 — stallshark bucket (HydraDB backend)
R2_STALLSHARK_BUCKET=stallshark

# HydraDB
HYDRADB_BOLT=bolt://127.0.0.1:7687
HYDRADB_TOKEN=your_hydra_token_here
HYDRADB_USER=neo4j

# Agent Vault (oracle)
# HYDRA_API_KEY stored in vault: oracle
